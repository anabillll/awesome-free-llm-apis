{%- comment -%} Display font (Latin) + Arabic fallback, self-hosted from theme assets. Safe to render in every section: browsers dedupe identical @font-face src URLs. {%- endcomment -%}
<style>
  @font-face {
    font-family: 'Caprasimo';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'caprasimo.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'Cairo';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    unicode-range: U+0600-06FF, U+0750-077F, U+200C-200E, U+FB50-FDFF, U+FE70-FEFC;
    src: url({{ 'cairo-arabic.woff2' | asset_url }}) format('woff2');
  }
</style>
