    "footer": {
      "type": "newsletter-footer",
      "blocks": {
        "shop": { "type": "link_column", "settings": { "heading": "Shop" } },
        "company": { "type": "link_column", "settings": { "heading": "Company" } },
        "local": { "type": "link_column", "settings": { "heading": "Local" } },
        "app": { "type": "app_badges", "settings": { "heading": "Get The App" } }
      },
      "block_order": ["shop", "company", "local", "app"],
      "settings": { "wave_top": true }
    }
  },
  "order": [
    "announcement-bar",
    "main",
    "faq",
    "featured-on",
    "testimonials",
    "stats",
    "ingredients",
    "timeline",
    "compare",
