{
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "msg-1": { "type": "message", "settings": { "text": "Free shipping on orders over $50" } },
        "msg-2": { "type": "message", "settings": { "text": "Subscribe & save 15% on every order" } },
        "msg-3": { "type": "message", "settings": { "text": "30-day guarantee, no questions asked" } }
      },
      "block_order": ["msg-1", "msg-2", "msg-3"],
      "settings": {}
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "check-1": { "type": "checklist_item", "settings": { "text": "Real cacao, clean ingredients" } },
        "check-2": { "type": "checklist_item", "settings": { "text": "Supports a steady, guilt-free snack habit" } },
        "check-3": { "type": "checklist_item", "settings": { "text": "Made in small batches, lab-verified" } },
        "check-4": { "type": "checklist_item", "settings": { "text": "Free from dairy, wheat, and the top 8 allergens" } },
        "tier-1": { "type": "pricing_tier", "settings": { "quantity": 1, "price": "900" } },
        "tier-2": { "type": "pricing_tier", "settings": { "quantity": 2, "price": "1620", "show_flavor_select": false, "save_percent": 10, "is_popular": true } },
        "tier-3": { "type": "pricing_tier", "settings": { "quantity": 3, "price": "2295", "save_percent": 15 } },
        "accordion-details": { "type": "accordion", "settings": { "heading": "Details" } },
        "accordion-shipping": { "type": "accordion", "settings": { "heading": "Shipping & Returns" } },
        "accordion-guarantee": { "type": "accordion", "settings": { "heading": "Our Guarantee" } },
        "trust-1": { "type": "trust_icon", "settings": { "label": "Free Shipping Over $50" } },
        "trust-2": { "type": "trust_icon", "settings": { "label": "30-Day Guarantee" } },
        "trust-3": { "type": "trust_icon", "settings": { "label": "Handcrafted Quality" } },
        "trust-4": { "type": "trust_icon", "settings": { "label": "Free Shipping" } }
      },
      "block_order": ["check-1", "check-2", "check-3", "check-4", "tier-1", "tier-2", "tier-3", "accordion-details", "accordion-shipping", "accordion-guarantee", "trust-1", "trust-2", "trust-3", "trust-4"],
      "settings": {
        "origin_badge_heading": "Made With Care",
        "origin_badge_subheading": "Small-batch, real ingredients",
        "tagline": "<p>Five ingredients to a chocolate bar that actually loves you back.</p>"
      }
    },
    "faq": {
      "type": "faq-accordion",
      "blocks": {
        "q1": { "type": "question", "settings": { "question": "Where are your chocolates made?" } },
        "q2": { "type": "question", "settings": { "question": "What ingredients are in your chocolate bars?" } },
        "q3": { "type": "question", "settings": { "question": "Are your products vegan?" } },
        "q4": { "type": "question", "settings": { "question": "Do your chocolate bars contain nuts?" } },
        "q5": { "type": "question", "settings": { "question": "What sweeteners do you use?" } }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5"],
      "settings": { "wave_top": true }
    },
    "featured-on": {
      "type": "featured-on",
      "blocks": {
        "logo-1": { "type": "logo", "settings": { "fallback_label": "Bon Appétit" } },
        "logo-2": { "type": "logo", "settings": { "fallback_label": "Forbes" } },
        "logo-3": { "type": "logo", "settings": { "fallback_label": "Vogue" } },
        "logo-4": { "type": "logo", "settings": { "fallback_label": "TechCrunch" } },
        "logo-5": { "type": "logo", "settings": { "fallback_label": "Well+Good" } }
      },
      "block_order": ["logo-1", "logo-2", "logo-3", "logo-4", "logo-5"],
      "settings": { "heading": "Trending On Social", "wave_top": true }
    },
    "testimonials": {
      "type": "testimonials",
      "blocks": {
        "t1": { "type": "testimonial", "settings": { "name": "Priya S.", "detail": "Verified Buyer", "rating": 5, "quote": "<p>Genuinely didn't expect a “healthy” chocolate bar to taste this good.</p>" } },
        "t2": { "type": "testimonial", "settings": { "name": "Marcus T.", "detail": "Verified Buyer", "rating": 5, "quote": "<p>Subscribed after the first bite. The banana one is unreal.</p>" } },
        "t3": { "type": "testimonial", "settings": { "name": "Elena R.", "detail": "Verified Buyer", "rating": 4, "quote": "<p>My kid can't tell it's not “regular” chocolate. Winning.</p>" } }
      },
      "block_order": ["t1", "t2", "t3"],
      "settings": { "layout": "spotlight" }
    },
    "stats": {
      "type": "stats-with-photo",
      "blocks": {
        "stat-1": { "type": "stat", "settings": { "number": "92%", "label": "of customers reorder within 60 days" } },
        "stat-2": { "type": "stat", "settings": { "number": "81%", "label": "say it curbed their sugar cravings" } },
        "stat-3": { "type": "stat", "settings": { "number": "87%", "label": "noticed a difference in the first week" } }
      },
      "block_order": ["stat-1", "stat-2", "stat-3"],
      "settings": { "heading": "Numbers That Back It Up", "image_position": "right" }
    },
    "ingredients": {
      "type": "ingredients-showcase",
      "blocks": {
        "cacao": { "type": "ingredient", "settings": { "name": "Cacao", "percent": 90 } },
        "sugar": { "type": "ingredient", "settings": { "name": "Coconut Sugar", "percent": 70 } },
        "vanilla": { "type": "ingredient", "settings": { "name": "Vanilla", "percent": 60 } }
      },
      "block_order": ["cacao", "sugar", "vanilla"],
      "settings": { "wave_top": true }
    },
    "timeline": {
      "type": "process-timeline",
      "blocks": {
        "week-1": { "type": "milestone", "settings": { "week_label": "Week 1", "heading": "Small-Batch Crafted", "text": "Your bars are made fresh to order in small batches, never sitting in a warehouse." } },
        "week-2": { "type": "milestone", "settings": { "week_label": "Week 2", "heading": "Quality Checked", "text": "Every batch is tasted and lab-verified before it's cleared to ship." } },
        "week-3": { "type": "milestone", "settings": { "week_label": "Week 3", "heading": "Shipped Fresh", "text": "Packed cold and sent out within days of production, not months." } },
        "week-4": { "type": "milestone", "settings": { "week_label": "Week 4", "heading": "On Your Doorstep", "text": "Enjoy it fresh — and if you subscribed, the next batch is already on its way." } }
      },
      "block_order": ["week-1", "week-2", "week-3", "week-4"],
      "settings": { "wave_top": true }
    },
    "compare": {
      "type": "comparison-table",
      "blocks": {
        "row-1": { "type": "feature_row", "settings": { "feature": "Premium Ingredients", "us": true } },
        "row-2": { "type": "feature_row", "settings": { "feature": "Unique Flavors", "us": true, "competitor_1": true } },
        "row-3": { "type": "feature_row", "settings": { "feature": "Handcrafted Quality", "us": true, "competitor_1": true, "competitor_2": true } },
        "row-4": { "type": "feature_row", "settings": { "feature": "Eco-Friendly Packaging", "us": true, "competitor_2": true } },
        "row-5": { "type": "feature_row", "settings": { "feature": "Instant Satisfaction", "us": true, "competitor_1": true, "competitor_2": true, "competitor_3": true } },
        "row-6": { "type": "feature_row", "settings": { "feature": "Vegan Options", "us": true, "competitor_2": true } },
        "tab-2": { "type": "comparison_tab", "settings": { "tab_label": "Vs. Gummies", "competitor_1_label": "Gummy Brand A", "competitor_2_label": "Gummy Brand B", "competitor_3_label": "Gummy Brand C", "rows": "Real Cacao|1|0|0|0\nNo Added Sugar Syrup|1|0|1|0\nSatisfies a Real Craving|1|1|1|0\nFree From Gelatin|1|0|0|1" } }
      },
      "block_order": ["row-1", "row-2", "row-3", "row-4", "row-5", "row-6", "tab-2"],
      "settings": { "wave_top": false, "tab_1_label": "Vs. Chocolate Bars" }
    },
    "gallery-grid": {
      "type": "image-gallery-grid",
      "blocks": {
        "image-1": { "type": "image" },
        "image-2": { "type": "image" },
        "image-3": { "type": "image" }
      },
      "block_order": ["image-1", "image-2", "image-3"],
      "settings": {}
    },
    "benefit-1": {
      "type": "media-with-text",
      "settings": { "heading": "Media with text Benefit 1", "image_position": "left" }
    },
    "benefit-2": {
      "type": "media-with-text",
      "settings": { "heading": "Media with text Benefit 2", "image_position": "right" }
    },
    "usp-bar": {
      "type": "usp-icon-bar",
      "blocks": {
        "no-dairy": { "type": "icon", "settings": { "label": "No Dairy" } },
        "no-wheat": { "type": "icon", "settings": { "label": "No Wheat" } },
        "no-nut": { "type": "icon", "settings": { "label": "No Nut" } },
        "no-corn": { "type": "icon", "settings": { "label": "No Corn" } },
        "no-soy": { "type": "icon", "settings": { "label": "No Soy" } },
        "no-gmo": { "type": "icon", "settings": { "label": "No GMO" } }
      },
      "block_order": ["no-dairy", "no-wheat", "no-nut", "no-corn", "no-soy", "no-gmo"],
      "settings": {}
    },
    "recommendations": {
      "type": "product-recommendations",
      "blocks": {
        "rec-1": { "type": "product" },
        "rec-2": { "type": "product" },
        "rec-3": { "type": "product" },
        "rec-4": { "type": "product" }
      },
      "block_order": ["rec-1", "rec-2", "rec-3", "rec-4"],
      "settings": {}
    },
    "final-cta": {
      "type": "last-chance-cta",
      "blocks": {
        "shop-now": { "type": "button", "settings": { "label": "Shop Now", "style": "solid" } },
        "learn-more": { "type": "button", "settings": { "label": "Learn More", "style": "outline" } }
      },
      "block_order": ["shop-now", "learn-more"],
      "settings": {}
