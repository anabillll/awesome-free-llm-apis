{%- comment -%} "Our Guilt-Free Chocolates" heading + 3-image grid {%- endcomment -%}
{%- render 'theme-fonts' -%}
<section class="img-grid" id="img-grid-{{ section.id }}">
  <div class="img-grid__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="img-grid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="img-grid__images">
      {%- for block in section.blocks -%}
        <div class="img-grid__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 100vw', widths: '400,600,800' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'img-grid__placeholder' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- style -%}
#img-grid-{{ section.id }} { padding: 48px 5vw; background: #fff; }
#img-grid-{{ section.id }} .img-grid__wrap { max-width: 1240px; margin: 0 auto; }
#img-grid-{{ section.id }} .img-grid__heading { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; text-align: center; font-size: clamp(22px, 3vw, 30px); margin: 0 0 28px; }
#img-grid-{{ section.id }} .img-grid__images { display: grid; grid-template-columns: 1fr; gap: 12px; }
@media (min-width: 640px) { #img-grid-{{ section.id }} .img-grid__images { grid-template-columns: repeat(3, 1fr); } }
#img-grid-{{ section.id }} .img-grid__item img,
#img-grid-{{ section.id }} .img-grid__item svg { width: 100%; height: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; border-radius: 6px; }
{%- endstyle -%}

{% schema %}
{
  "name": "Image gallery grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Guilt-Free Chocolates" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image gallery grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
