{%- comment -%} Newsletter subscribe bar + footer columns + bottom bar {%- endcomment -%}
{%- render 'theme-fonts' -%}
{%- render 'scroll-reveal' -%}
<section class="site-footer" id="site-footer-{{ section.id }}">
  <div class="site-footer__newsletter">
    <div class="site-footer__newsletter-wrap">
      <h2 class="site-footer__newsletter-heading reveal">{{ section.settings.newsletter_heading }}</h2>
      {%- if section.settings.newsletter_body != blank -%}
        <p class="site-footer__newsletter-body">{{ section.settings.newsletter_body }}</p>
      {%- endif -%}
      {%- form 'customer', id: 'ContactFooter', class: 'site-footer__newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ 'newsletter.email_placeholder' | t }}" required aria-label="{{ 'newsletter.email_placeholder' | t }}">
        <button type="submit">{{ 'newsletter.subscribe' | t }}</button>
        {%- if form.posted_successfully? -%}
          <p class="site-footer__newsletter-success">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <div class="site-footer__main">
    <div class="site-footer__main-wrap">
      <div class="site-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 160 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <p class="site-footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.brand_blurb != blank -%}
          <p class="site-footer__brand-blurb">{{ section.settings.brand_blurb }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_column' -%}
            <div class="site-footer__column" {{ block.shopify_attributes }}>
              <h3 class="site-footer__column-heading">{{ block.settings.heading }}</h3>
              <ul class="site-footer__column-list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'app_badges' -%}
            <div class="site-footer__column" {{ block.shopify_attributes }}>
              <h3 class="site-footer__column-heading">{{ block.settings.heading }}</h3>
              <div class="site-footer__app-badges">
                {%- if block.settings.ios_link != blank -%}
                  <a href="{{ block.settings.ios_link }}" aria-label="{{ 'general.footer.app_store' | t }}">
                    {{ block.settings.ios_badge | image_url: width: 140 | image_tag: loading: 'lazy' }}
                  </a>
                {%- endif -%}
                {%- if block.settings.android_link != blank -%}
                  <a href="{{ block.settings.android_link }}" aria-label="{{ 'general.footer.google_play' | t }}">
                    {{ block.settings.android_badge | image_url: width: 140 | image_tag: loading: 'lazy' }}
                  </a>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="site-footer__bottom-wrap">
      <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.all_rights_reserved' | t }}</p>

      <ul class="site-footer__social">
        {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{%- render 'icon-facebook' -%}</a></li>{%- endif -%}
        {%- if settings.social_twitter_link != blank -%}<li><a href="{{ settings.social_twitter_link }}" aria-label="Twitter">{%- render 'icon-twitter' -%}</a></li>{%- endif -%}
        {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram">IG</a></li>{%- endif -%}
      </ul>

      {%- if section.settings.show_payment_icons -%}
        <ul class="site-footer__payment">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{%- style -%}
#site-footer-{{ section.id }} { background: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; }
#site-footer-{{ section.id }} .site-footer__newsletter { padding: 40px 5vw; text-align: {{ section.settings.text_alignment }}; border-bottom: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.12 }}; }
#site-footer-{{ section.id }} .site-footer__newsletter-heading { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; font-size: clamp(20px, 3vw, 26px); margin: 0 0 10px; }
#site-footer-{{ section.id }} .site-footer__newsletter-body { opacity: .75; margin: 0 0 18px; }
#site-footer-{{ section.id }} .site-footer__newsletter-form { display: flex; gap: 8px; max-width: 420px; margin: 0 auto; flex-wrap: wrap; justify-content: center; }
#site-footer-{{ section.id }} .site-footer__newsletter-form input { flex: 1 1 240px; padding: 12px 14px; border-radius: 6px; border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.25 }}; background: transparent; color: {{ section.settings.text_color }}; }
#site-footer-{{ section.id }} .site-footer__newsletter-form button { padding: 12px 22px; border-radius: 6px; border: none; background: {{ section.settings.text_color }}; color: {{ section.settings.background_color }}; font-family: 'Poppins', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; cursor: pointer; transition: transform .1s; }
#site-footer-{{ section.id }} .site-footer__newsletter-form button:active { transform: scale(.97); }
#site-footer-{{ section.id }} .site-footer__main { padding: 40px 5vw; }
#site-footer-{{ section.id }} .site-footer__main-wrap { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 28px; }
@media (min-width: 640px) { #site-footer-{{ section.id }} .site-footer__main-wrap { grid-template-columns: 1.4fr repeat(3, 1fr); } }
#site-footer-{{ section.id }} .site-footer__brand img { max-width: 120px; margin-bottom: 12px; }
#site-footer-{{ section.id }} .site-footer__brand-name { font-weight: 700; font-size: 18px; margin: 0 0 12px; }
#site-footer-{{ section.id }} .site-footer__brand-blurb { opacity: .7; font-size: 13px; line-height: 1.6; }
#site-footer-{{ section.id }} .site-footer__column-heading { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; margin: 0 0 14px; }
#site-footer-{{ section.id }} .site-footer__column-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
#site-footer-{{ section.id }} .site-footer__column-list a { color: inherit; text-decoration: none; opacity: .75; font-size: 14px; }
#site-footer-{{ section.id }} .site-footer__column-list a:hover { opacity: 1; }
#site-footer-{{ section.id }} .site-footer__app-badges { display: flex; flex-direction: column; gap: 8px; }
#site-footer-{{ section.id }} .site-footer__app-badges a { display: block; width: fit-content; transition: transform .15s ease, opacity .15s ease; }
#site-footer-{{ section.id }} .site-footer__app-badges a:hover { transform: translateY(-2px); opacity: .85; }
#site-footer-{{ section.id }} .site-footer__app-badges img { max-width: 140px; }
#site-footer-{{ section.id }} .site-footer__bottom { border-top: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.12 }}; padding: 20px 5vw; }
#site-footer-{{ section.id }} .site-footer__bottom-wrap { max-width: 1240px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; font-size: 12px; opacity: .75; }
#site-footer-{{ section.id }} .site-footer__social { list-style: none; display: flex; gap: 12px; padding: 0; margin: 0; }
#site-footer-{{ section.id }} .site-footer__social a { color: inherit; }
#site-footer-{{ section.id }} .site-footer__payment { list-style: none; display: flex; gap: 8px; padding: 0; margin: 0; flex-wrap: wrap; }
#site-footer-{{ section.id }} .site-footer__payment svg { height: 22px; width: auto; }
{%- endstyle -%}

{% schema %}
{
  "name": "Newsletter + footer",
  "tag": "footer",
  "settings": [
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Subscribe To Our Emails" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "text", "id": "newsletter_body", "label": "Newsletter body", "default": "Be the first to know about new arrivals, sales, and exclusive offers." },
    { "type": "image_picker", "id": "logo", "label": "Footer logo" },
    { "type": "text", "id": "brand_blurb", "label": "Brand blurb", "default": "Guilt-free chocolate made with clean, real ingredients." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#17110b" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "app_badges",
      "name": "App badges",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get The App" },
        { "type": "image_picker", "id": "ios_badge", "label": "App Store badge" },
        { "type": "url", "id": "ios_link", "label": "App Store link" },
        { "type": "image_picker", "id": "android_badge", "label": "Google Play badge" },
        { "type": "url", "id": "android_link", "label": "Google Play link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Newsletter + footer",
      "blocks": [
        { "type": "link_column", "settings": { "heading": "Shop" } },
        { "type": "link_column", "settings": { "heading": "Company" } },
        { "type": "app_badges", "settings": { "heading": "Get The App" } }
      ]
    }
  ]
}
{% endschema %}
