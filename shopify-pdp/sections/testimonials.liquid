{%- comment -%} Customer testimonials / reviews grid {%- endcomment -%}
{%- render 'theme-fonts' -%}
{%- render 'scroll-reveal' -%}
<section class="testi" id="testi-{{ section.id }}">
{%- if section.settings.wave_top -%}{%- render 'wave-divider', color: section.settings.background_color -%}{%- endif -%}

  <div class="testi__wrap">
    <h2 class="testi__heading reveal">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="testi__subheading reveal">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.layout == 'spotlight' -%}
    <div class="testi__spotlight reveal" data-testi-spotlight>
      {%- for block in section.blocks -%}
        <div class="testi__spot{% if forloop.first %} is-active{% endif %}" data-spot-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.avatar != blank -%}
            <div class="testi__spot-photo">{{ block.settings.avatar | image_url: width: 300 | image_tag: loading: 'lazy' }}</div>
          {%- endif -%}
          <div class="testi__spot-rating" aria-label="{{ 'general.testimonials.rating' | t }}">
            {%- for i in (1..5) -%}<span class="testi__star{% if i <= block.settings.rating %} is-filled{% endif %}">★</span>{%- endfor -%}
          </div>
          <blockquote class="testi__spot-quote">{{ block.settings.quote }}</blockquote>
          <div class="testi__spot-name">{{ block.settings.name }}</div>
          {%- if block.settings.detail != blank -%}<div class="testi__spot-detail">{{ block.settings.detail }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
      {%- if section.blocks.size > 1 -%}
      <div class="testi__spot-nav">
        <button type="button" class="testi__spot-arrow" data-spot-prev aria-label="{{ 'general.testimonials.previous' | t }}">‹</button>
        <div class="testi__spot-dots" data-spot-dots>
          {%- for block in section.blocks -%}<button type="button" class="testi__spot-dot{% if forloop.first %} is-active{% endif %}" data-spot-dot="{{ forloop.index0 }}" aria-label="{{ 'general.testimonials.go_to' | t: index: forloop.index }}"></button>{%- endfor -%}
        </div>
        <button type="button" class="testi__spot-arrow" data-spot-next aria-label="{{ 'general.testimonials.next' | t }}">›</button>
      </div>
      {%- endif -%}
    </div>
    {%- else -%}
    <div class="testi__grid">
      {%- for block in section.blocks -%}
        <div class="testi__card reveal" style="transition-delay: {{ forloop.index0 | times: 80 }}ms;" {{ block.shopify_attributes }}>
          <div class="testi__rating" aria-label="{{ 'general.testimonials.rating' | t }}">
            {%- for i in (1..5) -%}<span class="testi__star{% if i <= block.settings.rating %} is-filled{% endif %}">★</span>{%- endfor -%}
          </div>
          <blockquote class="testi__quote">{{ block.settings.quote }}</blockquote>
          <div class="testi__author">
            {%- if block.settings.avatar != blank -%}
              <span class="testi__avatar">{{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy' }}</span>
            {%- endif -%}
            <span class="testi__author-text">
              <span class="testi__name">{{ block.settings.name }}</span>
              {%- if block.settings.detail != blank -%}<span class="testi__detail">{{ block.settings.detail }}</span>{%- endif -%}
            </span>
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
#testi-{{ section.id }} { position: relative; padding: 52px 5vw; background: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; }
#testi-{{ section.id }} .testi__wrap { max-width: 1240px; margin: 0 auto; }
#testi-{{ section.id }} .testi__heading { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; text-align: {{ section.settings.text_alignment }}; font-size: clamp(28px, 4vw, 40px); margin: 0 0 8px; }
#testi-{{ section.id }} .testi__subheading { text-align: {{ section.settings.text_alignment }}; opacity: .7; margin: 0 0 28px; font-size: 14px; }
#testi-{{ section.id }} .testi__grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
@media (min-width: 700px) { #testi-{{ section.id }} .testi__grid { grid-template-columns: repeat(3, 1fr); } }
#testi-{{ section.id }} .testi__card { border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.15 }}; border-radius: 8px; padding: 22px; display: flex; flex-direction: column; gap: 14px; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
#testi-{{ section.id }} .testi__card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px {{ section.settings.text_color | color_modify: 'alpha', 0.12 }}; border-color: {{ section.settings.text_color | color_modify: 'alpha', 0.3 }}; }
@media (prefers-reduced-motion: reduce) { #testi-{{ section.id }} .testi__card { transition: none; } }
#testi-{{ section.id }} .testi__rating { letter-spacing: 2px; }
#testi-{{ section.id }} .testi__star { opacity: .25; }
#testi-{{ section.id }} .testi__star.is-filled { opacity: 1; }
#testi-{{ section.id }} .testi__quote { margin: 0; font-size: 15px; line-height: 1.7; }
#testi-{{ section.id }} .testi__author { display: flex; align-items: center; gap: 10px; margin-top: auto; }
#testi-{{ section.id }} .testi__avatar img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; display: block; }
#testi-{{ section.id }} .testi__author-text { display: flex; flex-direction: column; font-size: 13px; }
#testi-{{ section.id }} .testi__name { font-weight: 700; }
#testi-{{ section.id }} .testi__detail { opacity: .65; font-size: 12px; }

#testi-{{ section.id }} .testi__spotlight { max-width: 640px; margin: 0 auto; text-align: center; }
#testi-{{ section.id }} .testi__spot { display: none; flex-direction: column; align-items: center; }
#testi-{{ section.id }} .testi__spot.is-active { display: flex; }
#testi-{{ section.id }} .testi__spot-photo { width: 84px; height: 84px; border-radius: 50%; overflow: hidden; margin-bottom: 16px; }
#testi-{{ section.id }} .testi__spot-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
#testi-{{ section.id }} .testi__spot-rating { letter-spacing: 3px; margin-bottom: 14px; font-size: 15px; }
#testi-{{ section.id }} .testi__spot-quote { margin: 0 0 18px; font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; font-size: clamp(20px, 3vw, 28px); line-height: 1.45; }
#testi-{{ section.id }} .testi__spot-name { font-weight: 700; font-size: 15px; }
#testi-{{ section.id }} .testi__spot-detail { opacity: .65; font-size: 13px; margin-top: 2px; }
#testi-{{ section.id }} .testi__spot-nav { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 28px; }
#testi-{{ section.id }} .testi__spot-arrow { background: none; border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.25 }}; color: inherit; width: 34px; height: 34px; border-radius: 50%; font-size: 18px; cursor: pointer; line-height: 1; transition: background .15s ease; }
#testi-{{ section.id }} .testi__spot-arrow:hover { background: {{ section.settings.text_color | color_modify: 'alpha', 0.08 }}; }
#testi-{{ section.id }} .testi__spot-dots { display: flex; gap: 8px; }
#testi-{{ section.id }} .testi__spot-dot { width: 8px; height: 8px; border-radius: 50%; border: none; padding: 0; background: {{ section.settings.text_color | color_modify: 'alpha', 0.25 }}; cursor: pointer; }
#testi-{{ section.id }} .testi__spot-dot.is-active { background: {{ section.settings.text_color }}; }
{%- endstyle -%}

<script>
(function () {
  var root = document.getElementById('testi-{{ section.id }}');
  if (!root) return;
  var spots = root.querySelectorAll('[data-spot-index]');
  var dots = root.querySelectorAll('[data-spot-dot]');
  if (!spots.length) return;
  var current = 0;
  function show(index) {
    current = (index + spots.length) % spots.length;
    spots.forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-spot-index') == current); });
    dots.forEach(function (d) { d.classList.toggle('is-active', d.getAttribute('data-spot-dot') == current); });
  }
  var prev = root.querySelector('[data-spot-prev]');
  var next = root.querySelector('[data-spot-next]');
  if (prev) prev.addEventListener('click', function () { show(current - 1); });
  if (next) next.addEventListener('click', function () { show(current + 1); });
  dots.forEach(function (d) {
    d.addEventListener('click', function () { show(parseInt(d.getAttribute('data-spot-dot'), 10)); });
  });
})();
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved By Chocolate People" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "grid", "label": "Grid (3 cards)" }, { "value": "spotlight", "label": "Spotlight (single, stacked)" } ], "default": "grid" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#fff8ec" },
        { "type": "checkbox", "id": "wave_top", "label": "Wavy top edge", "default": false },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#241134" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Genuinely didn't expect a 'healthy' chocolate bar to taste this good.</p>" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "name", "label": "Name", "default": "Happy Customer" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified Buyer" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Priya S.", "detail": "Verified Buyer", "rating": 5 } },
        { "type": "testimonial", "settings": { "name": "Marcus T.", "detail": "Verified Buyer", "rating": 5 } },
        { "type": "testimonial", "settings": { "name": "Elena R.", "detail": "Verified Buyer", "rating": 4 } }
      ]
    }
  ]
}
{% endschema %}
