{%- comment -%} "Featured On" press-logo marquee. Merchants upload a logo per block via the image picker; logos render grayscale and reveal full color on hover, matching the site's signature interaction. Scrolls left-to-right for LTR locales, right-to-left for RTL/Arabic locales. {%- endcomment -%}
{%- render 'theme-fonts' -%}
{%- render 'scroll-reveal' -%}
{%- liquid
  assign logo_blocks = section.blocks | where: 'type', 'logo'
  assign row_dir = 'ltr'
  if request.locale.rtl?
    assign row_dir = 'rtl'
  endif
-%}
<section class="featured-on" id="featured-on-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="featured-on__heading reveal">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if logo_blocks.size > 0 -%}
  <div class="featured-on__row" dir="{{ row_dir }}">
    <div class="featured-on__track">
      <div class="featured-on__group">
        {%- for block in logo_blocks -%}
          <div class="featured-on__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="featured-on__link">{%- endif -%}
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', class: 'featured-on__img' }}
            {%- else -%}
              <span class="featured-on__placeholder">{{ block.settings.fallback_label | default: 'Your Logo' }}</span>
            {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="featured-on__group" aria-hidden="true">
        {%- for block in logo_blocks -%}
          <div class="featured-on__item">
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="featured-on__link" tabindex="-1">{%- endif -%}
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy' }}
            {%- else -%}
              <span class="featured-on__placeholder">{{ block.settings.fallback_label | default: 'Your Logo' }}</span>
            {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}
</section>

{%- style -%}
#featured-on-{{ section.id }} {
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
  padding: 44px 0;
}
#featured-on-{{ section.id }} .featured-on__heading {
  text-align: center;
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  opacity: .6;
  margin: 0 0 28px;
}
#featured-on-{{ section.id }} .featured-on__row { overflow: hidden; }
#featured-on-{{ section.id }} .featured-on__track {
  display: flex;
  width: max-content;
  animation: featured-on-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
}
#featured-on-{{ section.id }} .featured-on__row[dir="rtl"] .featured-on__track { animation-direction: reverse; }
#featured-on-{{ section.id }} .featured-on__group { display: flex; flex-shrink: 0; align-items: center; }
#featured-on-{{ section.id }} .featured-on__item { display: flex; align-items: center; justify-content: center; padding-inline-end: 64px; }
#featured-on-{{ section.id }} .featured-on__link { display: block; }
#featured-on-{{ section.id }} .featured-on__img {
  height: 32px;
  width: auto;
  max-width: 140px;
  object-fit: contain;
  filter: grayscale(1);
  opacity: .55;
  transition: filter .3s ease, opacity .3s ease, transform .3s ease;
}
#featured-on-{{ section.id }} .featured-on__item:hover .featured-on__img { filter: grayscale(0); opacity: 1; transform: scale(1.06); }
#featured-on-{{ section.id }} .featured-on__placeholder {
  display: block;
  white-space: nowrap;
  border: 1px dashed {{ section.settings.text_color | color_modify: 'alpha', 0.35 }};
  border-radius: 6px;
  padding: 8px 18px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .04em;
  text-transform: uppercase;
  opacity: .55;
  transition: opacity .3s ease;
}
#featured-on-{{ section.id }} .featured-on__item:hover .featured-on__placeholder { opacity: 1; }
@keyframes featured-on-scroll-{{ section.id }} {
  from { transform: translateX(-50%); }
  to { transform: translateX(0%); }
}
{%- if section.settings.pause_on_hover -%}
#featured-on-{{ section.id }} .featured-on__row:hover .featured-on__track { animation-play-state: paused; }
{%- endif -%}
@media (prefers-reduced-motion: reduce) {
  #featured-on-{{ section.id }} .featured-on__track { animation: none; }
  #featured-on-{{ section.id }} .featured-on__img,
  #featured-on-{{ section.id }} .featured-on__placeholder { transition: none; }
}
{%- endstyle -%}

{% schema %}
{
  "name": "Featured on",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As Featured On" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#17110b" },
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds per loop)", "min": 8, "max": 60, "step": 1, "default": 28 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" },
        { "type": "text", "id": "fallback_label", "label": "Fallback text (shown until a logo is uploaded)", "default": "Your Logo" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured on",
      "blocks": [
        { "type": "logo", "settings": { "fallback_label": "Bon Appétit" } },
        { "type": "logo", "settings": { "fallback_label": "Forbes" } },
        { "type": "logo", "settings": { "fallback_label": "Vogue" } },
        { "type": "logo", "settings": { "fallback_label": "TechCrunch" } },
        { "type": "logo", "settings": { "fallback_label": "Well+Good" } }
      ]
    }
  ]
}
{% endschema %}
