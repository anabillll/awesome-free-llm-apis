{%- comment -%} Centered "Last Chance CTA" banner with configurable buttons {%- endcomment -%}
{%- render 'theme-fonts' -%}
{%- render 'scroll-reveal' -%}
<section class="final-cta" id="final-cta-{{ section.id }}">
{%- if section.settings.wave_top -%}{%- render 'wave-divider', color: section.settings.background_color -%}{%- endif -%}

  <div class="final-cta__wrap">
    <h2 class="final-cta__heading reveal">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="final-cta__body">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
    <div class="final-cta__actions">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="final-cta__button final-cta__button--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
#final-cta-{{ section.id }} { position: relative; padding: 56px 5vw; text-align: {{ section.settings.text_alignment }}; background: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; }
#final-cta-{{ section.id }} .final-cta__wrap { max-width: 640px; margin: 0 auto; }
#final-cta-{{ section.id }} .final-cta__heading { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; font-size: clamp(22px, 3vw, 30px); margin: 0 0 12px; }
#final-cta-{{ section.id }} .final-cta__body { opacity: .75; line-height: 1.7; margin: 0 0 24px; }
#final-cta-{{ section.id }} .final-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
#final-cta-{{ section.id }} .final-cta__button { padding: 13px 30px; border-radius: 6px; font-family: 'Poppins', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; text-decoration: none; text-transform: uppercase; letter-spacing: .03em; transition: transform .1s; display: inline-block; }
#final-cta-{{ section.id }} .final-cta__button:active { transform: scale(.97); }
#final-cta-{{ section.id }} .final-cta__button--solid { background: {{ section.settings.text_color }}; color: {{ section.settings.background_color }}; }
#final-cta-{{ section.id }} .final-cta__button--solid:hover { opacity: .85; }
#final-cta-{{ section.id }} .final-cta__button--outline { border: 1px solid {{ section.settings.text_color }}; color: {{ section.settings.text_color }}; }
#final-cta-{{ section.id }} .final-cta__button--outline:hover { background: {{ section.settings.text_color | color_modify: 'alpha', 0.08 }}; }
{%- endstyle -%}

{% schema %}
{
  "name": "Last chance CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Last Chance CTA" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "text", "id": "body", "label": "Body text", "default": "Add up personal to grab this before you go. Order now to lock in your deal today." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
        { "type": "checkbox", "id": "wave_top", "label": "Wavy top edge", "default": false },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#17110b" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop Now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" } ], "default": "solid" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Last chance CTA",
      "blocks": [
        { "type": "button", "settings": { "label": "Shop Now", "style": "solid" } },
        { "type": "button", "settings": { "label": "Learn More", "style": "outline" } }
      ]
    }
  ]
}
{% endschema %}
