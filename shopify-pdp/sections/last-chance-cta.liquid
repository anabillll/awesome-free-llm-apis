{%- comment -%} Centered "Last Chance CTA" banner with two buttons {%- endcomment -%}
{%- render 'theme-fonts' -%}
<section class="final-cta" id="final-cta-{{ section.id }}">
  <div class="final-cta__wrap">
    <h2 class="final-cta__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="final-cta__body">{{ section.settings.body }}</p>
    {%- endif -%}
    <div class="final-cta__actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_link | default: '#' }}" class="final-cta__button final-cta__button--solid">{{ section.settings.primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link | default: '#' }}" class="final-cta__button final-cta__button--outline">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- style -%}
#final-cta-{{ section.id }} { padding: 56px 5vw; text-align: center; background: #fff; }
#final-cta-{{ section.id }} .final-cta__wrap { max-width: 640px; margin: 0 auto; }
#final-cta-{{ section.id }} .final-cta__heading { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; font-size: clamp(22px, 3vw, 30px); margin: 0 0 12px; }
#final-cta-{{ section.id }} .final-cta__body { opacity: .75; line-height: 1.7; margin: 0 0 24px; }
#final-cta-{{ section.id }} .final-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
#final-cta-{{ section.id }} .final-cta__button { padding: 13px 30px; border-radius: 6px; font-weight: 700; text-decoration: none; text-transform: uppercase; letter-spacing: .03em; font-size: 13px; }
#final-cta-{{ section.id }} .final-cta__button--solid { background: #17110b; color: #fff; }
#final-cta-{{ section.id }} .final-cta__button--outline { border: 1px solid #17110b; color: #17110b; }
{%- endstyle -%}

{% schema %}
{
  "name": "Last chance CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Last Chance CTA" },
    { "type": "text", "id": "body", "label": "Body text", "default": "Add up personal to grab this before you go. Order now to lock in your deal today." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop Now" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Learn More" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [
    { "name": "Last chance CTA" }
  ]
}
{% endschema %}
