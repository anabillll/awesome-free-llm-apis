{%- comment -%} Week-by-week "Fresh in 30 Days" process timeline {%- endcomment -%}
{%- render 'theme-fonts' -%}
{%- render 'scroll-reveal' -%}
<section class="timeline" id="timeline-{{ section.id }}">
{%- if section.settings.wave_top -%}{%- render 'wave-divider', color: section.settings.background_color -%}{%- endif -%}

  <div class="timeline__wrap">
    <h2 class="timeline__heading reveal">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="timeline__subheading reveal">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="timeline__track">
      {%- for block in section.blocks -%}
        <div class="timeline__item reveal" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
          <div class="timeline__marker">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 60 | image_tag: loading: 'lazy' }}
            {%- else -%}
              <span class="timeline__dot">{{ forloop.index }}</span>
            {%- endif -%}
          </div>
          <div class="timeline__body">
            <span class="timeline__week">{{ block.settings.week_label }}</span>
            <h3 class="timeline__item-heading">{{ block.settings.heading }}</h3>
            <p class="timeline__item-text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- style -%}
#timeline-{{ section.id }} { position: relative; padding: 48px 5vw; background: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; }
#timeline-{{ section.id }} .timeline__wrap { max-width: 760px; margin: 0 auto; }
#timeline-{{ section.id }} .timeline__heading { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; text-align: {{ section.settings.text_alignment }}; font-size: clamp(22px, 3vw, 30px); margin: 0 0 8px; }
#timeline-{{ section.id }} .timeline__subheading { text-align: {{ section.settings.text_alignment }}; opacity: .7; margin: 0 0 36px; font-size: 14px; }
#timeline-{{ section.id }} .timeline__track { display: flex; flex-direction: column; }
#timeline-{{ section.id }} .timeline__item { position: relative; display: flex; gap: 20px; padding-bottom: 34px; }
#timeline-{{ section.id }} .timeline__item:last-child { padding-bottom: 0; }
#timeline-{{ section.id }} .timeline__item:not(:last-child)::after { content: ''; position: absolute; inset-inline-start: 21px; top: 46px; bottom: -4px; width: 2px; background: {{ section.settings.text_color | color_modify: 'alpha', 0.18 }}; }
#timeline-{{ section.id }} .timeline__marker { flex: none; width: 44px; height: 44px; border-radius: 50%; background: {{ section.settings.background_color }}; border: 2px solid {{ section.settings.text_color | color_modify: 'alpha', 0.3 }}; display: flex; align-items: center; justify-content: center; overflow: hidden; }
#timeline-{{ section.id }} .timeline__marker img { width: 26px; height: 26px; object-fit: contain; }
#timeline-{{ section.id }} .timeline__dot { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; font-size: 15px; }
#timeline-{{ section.id }} .timeline__body { padding-top: 6px; }
#timeline-{{ section.id }} .timeline__week { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; opacity: .55; margin-bottom: 4px; }
#timeline-{{ section.id }} .timeline__item-heading { margin: 0 0 6px; font-size: 17px; font-weight: 700; }
#timeline-{{ section.id }} .timeline__item-text { margin: 0; font-size: 14px; line-height: 1.6; opacity: .8; }
{%- endstyle -%}

{% schema %}
{
  "name": "Process timeline",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh in 30 Days" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From our kitchen to your doorstep — here's what happens after you order." },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "checkbox", "id": "wave_top", "label": "Wavy top edge", "default": false },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#fff8ec" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#241134" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "week_label", "label": "Week label", "default": "Week 1" },
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Small-Batch Crafted" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Your bars are made fresh to order in small batches, never sitting in a warehouse." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Process timeline",
      "blocks": [
        { "type": "milestone", "settings": { "week_label": "Week 1", "heading": "Small-Batch Crafted", "text": "Your bars are made fresh to order in small batches, never sitting in a warehouse." } },
        { "type": "milestone", "settings": { "week_label": "Week 2", "heading": "Quality Checked", "text": "Every batch is tasted and lab-verified before it's cleared to ship." } },
        { "type": "milestone", "settings": { "week_label": "Week 3", "heading": "Shipped Fresh", "text": "Packed cold and sent out within days of production, not months." } },
        { "type": "milestone", "settings": { "week_label": "Week 4", "heading": "On Your Doorstep", "text": "Enjoy it fresh — and if you subscribed, the next batch is already on its way." } }
      ]
    }
  ]
}
{% endschema %}
