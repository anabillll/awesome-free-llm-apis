{%- comment -%} Dark "Ingredients That Make A Difference" section with icon rows + progress bars {%- endcomment -%}
{%- render 'theme-fonts' -%}
{%- render 'scroll-reveal' -%}
<section class="ingredients" id="ingredients-{{ section.id }}">
  <div class="ingredients__wrap">
    <div class="ingredients__intro">
      <h2 class="ingredients__heading reveal">{{ section.settings.heading }}</h2>
      <div class="ingredients__body">{{ section.settings.body }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="ingredients__button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="ingredients__list" data-ingredients-list>
      {%- for block in section.blocks -%}
        <div class="ingredients__row reveal" style="transition-delay: {{ forloop.index0 | times: 80 }}ms;" {{ block.shopify_attributes }}>
          <span class="ingredients__icon">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ 'ingredient' | placeholder_svg_tag: 'ingredients__placeholder' }}
            {%- endif -%}
          </span>
          <span class="ingredients__name">{{ block.settings.name }}</span>
          <span class="ingredients__bar-track">
            <span class="ingredients__bar-fill" style="width: {{ block.settings.percent }}%;"></span>
          </span>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 0 -%}
    <div class="ingredients__dots" data-ingredients-dots>
      {%- for block in section.blocks -%}
        <button type="button" class="ingredients__dot{% if forloop.first %} is-active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="{{ 'general.slider.go_to_slide' | t: index: forloop.index }}"></button>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
#ingredients-{{ section.id }} { background: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; padding: 56px 5vw; }
#ingredients-{{ section.id }} .ingredients__wrap { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 32px; }
@media (min-width: 860px) { #ingredients-{{ section.id }} .ingredients__wrap { grid-template-columns: 1fr 1.1fr; align-items: center; } }
#ingredients-{{ section.id }} .ingredients__intro { text-align: {{ section.settings.text_alignment }}; }
#ingredients-{{ section.id }} .ingredients__heading { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; font-size: clamp(24px, 3vw, 32px); margin: 0 0 16px; }
#ingredients-{{ section.id }} .ingredients__body { opacity: .8; line-height: 1.7; margin-bottom: 22px; }
#ingredients-{{ section.id }} .ingredients__button { display: inline-block; background: {{ section.settings.text_color }}; color: {{ section.settings.background_color }}; padding: 12px 28px; border-radius: 6px; text-decoration: none; font-family: 'Poppins', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; }
#ingredients-{{ section.id }} .ingredients__list { display: flex; flex-direction: column; gap: 18px; }
#ingredients-{{ section.id }} .ingredients__row { display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 16px; padding: 6px 8px; margin: 0 -8px; border-radius: 6px; transition: background .15s ease; }
#ingredients-{{ section.id }} .ingredients__row:hover { background: {{ section.settings.text_color | color_modify: 'alpha', 0.08 }}; }
#ingredients-{{ section.id }} .ingredients__icon img,
#ingredients-{{ section.id }} .ingredients__icon svg { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
#ingredients-{{ section.id }} .ingredients__name { font-size: 14px; font-weight: 600; min-width: 90px; }
#ingredients-{{ section.id }} .ingredients__bar-track { height: 6px; border-radius: 3px; background: {{ section.settings.text_color | color_modify: 'alpha', 0.15 }}; overflow: hidden; }
#ingredients-{{ section.id }} .ingredients__bar-fill { display: block; height: 100%; background: currentColor; border-radius: 3px; }
#ingredients-{{ section.id }} .ingredients__dots { display: flex; gap: 8px; justify-content: center; margin-top: 8px; grid-column: 1 / -1; }
@media (min-width: 860px) { #ingredients-{{ section.id }} .ingredients__dots { justify-content: flex-end; } }
#ingredients-{{ section.id }} .ingredients__dot { width: 8px; height: 8px; border-radius: 50%; border: none; background: {{ section.settings.text_color | color_modify: 'alpha', 0.3 }}; padding: 0; cursor: pointer; }
#ingredients-{{ section.id }} .ingredients__dot.is-active { background: {{ section.settings.text_color }}; }
{%- endstyle -%}

<script>
(function () {
  var root = document.getElementById('ingredients-{{ section.id }}');
  if (!root) return;
  var rows = root.querySelectorAll('.ingredients__row');
  var dots = root.querySelectorAll('[data-ingredients-dots] .ingredients__dot');
  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      dots.forEach(function (d) { d.classList.remove('is-active'); });
      dot.classList.add('is-active');
      var index = parseInt(dot.getAttribute('data-dot-index'), 10);
      var row = rows[index];
      if (row && row.scrollIntoView) row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Ingredients showcase",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredients That Make A Difference" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Ingredients: Cacao, Cocoa Butter, Coconut Sugar, Vanilla, and Salt. Nothing artificial, ever.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#17110b" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "name", "label": "Name", "default": "Cacao" },
        { "type": "range", "id": "percent", "label": "Bar fill percent", "min": 0, "max": 100, "step": 5, "default": 80 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients showcase",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Cacao", "percent": 90 } },
        { "type": "ingredient", "settings": { "name": "Coconut Sugar", "percent": 70 } },
        { "type": "ingredient", "settings": { "name": "Vanilla", "percent": 60 } }
      ]
    }
  ]
}
{% endschema %}
