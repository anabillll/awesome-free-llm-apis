{%- comment -%} Reusable image + text block, image position configurable per instance {%- endcomment -%}
{%- render 'theme-fonts' -%}
{%- render 'scroll-reveal' -%}
<section class="media-text{% if section.settings.image_position == 'right' %} media-text--reverse{% endif %}" id="media-text-{{ section.id }}">
  <div class="media-text__wrap">
    <div class="media-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '500,750,1000' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'media-text__placeholder' }}
      {%- endif -%}
    </div>
    <div class="media-text__content reveal">
      <h2 class="media-text__heading">{{ section.settings.heading }}</h2>
      <div class="media-text__body">{{ section.settings.body }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="media-text__button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- style -%}
#media-text-{{ section.id }} { padding: 32px 5vw; background: #fff; }
#media-text-{{ section.id }} .media-text__wrap { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 28px; align-items: center; }
@media (min-width: 800px) { #media-text-{{ section.id }} .media-text__wrap { grid-template-columns: 1fr 1fr; gap: 56px; } }
#media-text-{{ section.id }}.media-text--reverse .media-text__media { order: 2; }
@media (min-width: 800px) {
  #media-text-{{ section.id }}.media-text--reverse .media-text__media { order: 1; }
  #media-text-{{ section.id }}.media-text--reverse .media-text__content { order: 2; }
}
#media-text-{{ section.id }} .media-text__content { text-align: {{ section.settings.text_alignment }}; }
#media-text-{{ section.id }} .media-text__media img,
#media-text-{{ section.id }} .media-text__media svg { width: 100%; height: auto; border-radius: 8px; display: block; }
#media-text-{{ section.id }} .media-text__heading { font-family: 'Caprasimo', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; font-size: clamp(22px, 3vw, 30px); margin: 0 0 14px; }
#media-text-{{ section.id }} .media-text__body { font-size: 15px; line-height: 1.7; opacity: .8; margin-bottom: 20px; }
#media-text-{{ section.id }} .media-text__button { display: inline-block; background: #17110b; color: #fff; padding: 12px 28px; border-radius: 6px; text-decoration: none; font-family: 'Poppins', 'Cairo', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 16px; font-weight: 400; line-height: 24px; }
{%- endstyle -%}

{% schema %}
{
  "name": "Media with text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Media with text Benefit 1" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Put longer text with images or gifs here to give a fuller picture, reflection, or blog post. Add details or credibility, style, or even product details.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Media with text" }
  ]
}
{% endschema %}
